<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net10.0-windows</TargetFramework>
  <UseWPF>true</UseWPF>
  <UseWindowsForms>true</UseWindowsForms>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
  <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  <EnableDefaultPageItems>false</EnableDefaultPageItems>
  <StartupObject>BackupReminder.ReviewEntry</StartupObject>
  <AssemblyName>Backup-Reminder</AssemblyName>
  <Version>1.0.2</Version>
  <ApplicationIcon>brand-review.ico</ApplicationIcon>
  <DebugType>none</DebugType>
  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
 </PropertyGroup>
 <ItemGroup>
  <Compile Include="../BackupReminder/*.cs" />
  <Compile Include="Review.cs" />
  <Compile Include="Bridge.cs" />
  <Compile Include="Glyphs.cs" />
  <Compile Include="Pages.cs" />
  <Compile Include="../DgxDesktop/DgxAboutView.cs" />
  <Compile Include="SchedulePage.cs" />
  <Compile Include="ReminderStatus.cs" />
  <Compile Include="ReminderDelivery.cs" />
  <Compile Include="WindowSizing.cs" />
  <Compile Include="StartupRegistration.cs" />
  <Compile Include="StartupTests.cs" />
  <Compile Include="SetupUpdates.cs" />
  <Compile Include="ScheduleTests.cs" />
  <Compile Include="Tray.cs" />
  <Compile Include="Reorder.cs" />
  <Compile Include="CorrectionsTests.cs" />
  <EmbeddedResource Include="../../settings.example.json" LogicalName="starter.json" />
  <EmbeddedResource Include="ReviewHelp.json" LogicalName="review-help.json" />
  <EmbeddedResource Include="brand-review.png" LogicalName="brand.png" />
  <EmbeddedResource Include="brand-review.ico" LogicalName="brand.ico" />
  <EmbeddedResource Include="../../assets/dgx-publisher.png" LogicalName="publisher.png" />
  <EmbeddedResource Include="../../src/BackupReminder/Fluent-Icons-LICENSE.txt" LogicalName="Fluent-Icons-LICENSE.txt" />
  <EmbeddedResource Include="../DgxDesktop/ForgePresentation.xaml" LogicalName="styles.xaml" />
  <EmbeddedResource Include="../DgxDesktop/Shell.xaml" LogicalName="shell.xaml" />
  <EmbeddedResource Include="pin.txt" LogicalName="pin.txt" />
 </ItemGroup>
</Project>